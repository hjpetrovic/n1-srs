<?xml version="1.0" encoding="utf-8"?>
<!--
  "N1" in a pink→purple gradient on the dark background.
  Letters are used as a clip path over a gradient fill so the gradient
  flows continuously across both characters.
  Viewport 108×108, safe zone centre circle r=36 at (54,54).

  N  — left bar + diagonal parallelogram + right bar
  1  — small top flag + vertical bar
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group>
        <!-- Clip to the letter shapes -->
        <clip-path
            android:pathData="
                M33,32 L41,32 L41,76 L33,76 Z
                M33,32 L41,32 L61,76 L53,76 Z
                M53,32 L61,32 L61,76 L53,76 Z
                M61,32 L69,32 L69,38 L61,38 Z
                M69,32 L77,32 L77,76 L69,76 Z
            " />

        <!-- Gradient rectangle — clipped to letters above -->
        <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="33"
                    android:startY="32"
                    android:endX="77"
                    android:endY="76"
                    android:startColor="#F472B6"
                    android:endColor="#818CF8" />
            </aapt:attr>
        </path>
    </group>

</vector>
